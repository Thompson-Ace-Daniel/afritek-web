VITE_API_BASE_URL=https://afritek-api.vercel.app/api/v1
VITE_APP_NAME=Afritek

# Minimum withdrawal, in USD — the currency wallet balances are held in.
# Display hint only: the API enforces the real floor (MIN_WITHDRAWAL_USD) and
# rejects anything under it, so keep the two values in step. Optional; the form
# falls back to 10.
VITE_MIN_WITHDRAWAL_USD=10
